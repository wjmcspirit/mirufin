{
  "name": "mirufin",
  "private": true,
  "version": "0.1.43",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "check": "esbuild tools/check.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.mirufin/check.mjs && node node_modules/.mirufin/check.mjs",
    "navcheck": "esbuild tools/navCheck.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.mirufin/navCheck.mjs && node node_modules/.mirufin/navCheck.mjs",
    "seasoncheck": "esbuild tools/seasonCheck.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.mirufin/seasonCheck.mjs && node node_modules/.mirufin/seasonCheck.mjs",
    "collectioncheck": "esbuild tools/collectionCheck.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.mirufin/collectionCheck.mjs && node node_modules/.mirufin/collectionCheck.mjs",
    "personcheck": "esbuild tools/personCheck.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.mirufin/personCheck.mjs && node node_modules/.mirufin/personCheck.mjs",
    "discoverycheck": "esbuild tools/discoveryCheck.ts --bundle --platform=node --format=esm --log-level=warning --outfile=node_modules/.mirufin/discoveryCheck.mjs && node node_modules/.mirufin/discoveryCheck.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "hls.js": "^1.6.13",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.6.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/cli": "^8.5.3",
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^4.4.1",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
