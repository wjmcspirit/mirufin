<?xml version="1.0" encoding="utf-8"?>
<!-- Shown when a launch never reaches the web app, and shown again at the start of the
     next launch so the reason is readable even when starting the WebView is what kills
     the app. Mirufin used to leave nothing but a blank screen behind in that case. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/problem_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:orientation="vertical"
    android:padding="56dp">

    <TextView
        android:id="@+id/problem_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/problem_title"
        android:textColor="#FFF4F7FF"
        android:textSize="32sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/problem_detail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:lineSpacingMultiplier="1.15"
        android:textColor="#FF9AA3B5"
        android:textSize="19sp" />

    <TextView
        android:id="@+id/problem_device"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:lineSpacingMultiplier="1.15"
        android:textColor="#FF6D7688"
        android:textSize="17sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/problem_restart"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:focusable="true"
            android:text="@string/problem_restart"
            android:textColor="#FF09090B"
            android:textSize="19sp" />

        <Button
            android:id="@+id/problem_clear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:focusable="true"
            android:text="@string/problem_clear"
            android:textColor="#FF09090B"
            android:textSize="19sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/problem_log"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="20dp"
        android:layout_weight="1"
        android:fontFamily="monospace"
        android:textColor="#FF6D7688"
        android:textSize="13sp" />
</LinearLayout>
